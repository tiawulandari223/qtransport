# Salin ke .env lalu sesuaikan. Semua baris opsional — tanpa .env pun aplikasi jalan.
# Path absolut; biarkan kosong untuk memakai default (storage/app.sqlite)
# Contoh bila DB di luar document root: /home/user/qtransport/data/app.sqlite
DB_PATH=
# Contoh: /home/user/qtransport/data/reports
REPORTS_PATH=
# Menit idle sebelum session hangus (default 480 = 8 jam)
SESSION_TTL=480
# Opsional: prefix URL publik bila app tidak di root, mis. /qtransport
BASE_URL=
